# FILE: zenos/hosts/debug/host.zcfg

# Module Tests
users.debug-user = {
  legacy = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    initialPassword = "password";
    home-manager.home.stateVersion = "26.05";
  };
  packages = {
    legacy.kitty = true;
    apps.system.zenos.installer = true;
  };
};

desktops.gnome.enable = true;

legacy = {
  # 1. Changes /etc/os-release and Bootloader labels
  system.nixos = {
    distroName = "ZenOS";
    distroId = "zenos";
  };
};
